#!/bin/bash
# The data host's first boot (infra/terraform/stack/data_host.tf): Docker and Compose, the
# bundle from S3, .env from SSM, then the containers. The log is in /var/log/cloud-init-output.log.
set -euo pipefail

# User data runs once: a step that failed on a network blip would leave the host empty until
# the instance is replaced, so every step that reaches the network is retried.
retry() {
  local n
  for n in 1 2 3 4 5; do
    "$@" && return 0
    echo "failed (attempt $n), retrying: $1 $2" >&2
    sleep $((n * 5))
  done
  return 1
}

retry dnf install -y docker unzip
systemctl enable --now docker

# Compose isn't packaged for Amazon Linux 2023: the release binary, checked against its digest.
mkdir -p /usr/local/lib/docker/cli-plugins
retry curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  https://github.com/docker/compose/releases/download/v5.6.0/docker-compose-linux-aarch64
echo "733ec76717ceb59052a9609b9dadfb523b2df8eab57a54212872d10a58078ea2  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/doodle
cd /opt/doodle

# The OpenTelemetry agent for the Kafka broker (infra/kafka/Dockerfile has the same jar locally),
# checked against Maven Central's digest.
mkdir -p kafka-otel
retry curl -fsSL -o kafka-otel/opentelemetry-javaagent.jar \
  https://repo1.maven.org/maven2/io/opentelemetry/javaagent/opentelemetry-javaagent/2.32.0/opentelemetry-javaagent-2.32.0.jar
echo "f787eb6c7f3d18e69a431e108a15278d25ee37f83d68b678f621e063f3988f82  kafka-otel/opentelemetry-javaagent.jar" | sha256sum -c
chmod 644 kafka-otel/opentelemetry-javaagent.jar
retry aws s3 cp --region ${region} "s3://${bundle_bucket}/${bundle_key}" bundle.zip
unzip -o -q bundle.zip
chmod +x kafka/*.sh redis/*.sh postgres/init/*.sh

# Secrets never touch the user data or a log: read with the instance role, written mode 600.
# Each is read into a variable first: inside echo "X=$(...)" a failed read would go unnoticed
# and write an empty value, which compose then refuses.
param() { retry aws ssm get-parameter --region ${region} --with-decryption --name "/doodle-arena/$1" --query Parameter.Value --output text; }
umask 077
{
  echo "DATA_HOST_NAME=${data_host_name}"
%{ for var, name in env ~}
  value="$(param ${name})"
  echo "${var}=$value"
%{ endfor ~}
} > .env
# The broker's TLS key and certificate (kafka.tf), for the Kafka container's user (uid 1000).
mkdir -p kafka-tls
param stack/kafka-server-pem > kafka-tls/server.pem
param stack/kafka-ca-pem > kafka-tls/ca.pem
chown 1000:1000 kafka-tls/server.pem
chmod 644 kafka-tls/ca.pem
chmod 755 kafka-tls
# Until a human puts the Discord webhook (docs/setup.md), alerts go nowhere instead of failing.
sed -i 's|^DISCORD_ALERT_WEBHOOK_URL=unset$|DISCORD_ALERT_WEBHOOK_URL=http://127.0.0.1:9/discord-not-configured|' .env

# Not --wait: mongo-users and kafka-init are one-shot jobs that exit when done.
docker compose up -d
