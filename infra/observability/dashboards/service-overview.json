{
  "uid": "da-overview",
  "title": "Doodle Arena: service overview",
  "description": "RED metrics for every service (HTTP and gRPC servers), auth, the lobby and firing alerts, and the web app's Core Web Vitals from real users.",
  "tags": [
    "doodle-arena"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "doodle-arena"
      ],
      "asDropdown": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Alerts",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "type": "alertlist",
      "title": "Firing and pending alerts",
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": true
        },
        "folder": {
          "title": "Doodle Arena"
        },
        "showInstances": true
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Errors and warnings, every service",
      "description": "JSON logs from Loki. A line's trace_id links to its trace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\".+\"} | detected_level=~\"error|warn\""
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Requests (HTTP and gRPC servers)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count[$__rate_interval]) or rate(rpc_server_call_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Server errors (share of requests)",
      "description": "HTTP 5xx, plus gRPC UNKNOWN, DEADLINE_EXCEEDED, INTERNAL, UNAVAILABLE and DATA_LOSS. The HighErrorRate alert fires above 1%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval]) or rate(rpc_server_call_duration_seconds_count{rpc_response_status_code=~\"UNKNOWN|DEADLINE_EXCEEDED|INTERNAL|UNAVAILABLE|DATA_LOSS\"}[$__rate_interval])) / sum by (service_name) (rate(http_server_request_duration_seconds_count[$__rate_interval]) or rate(rpc_server_call_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval]) or rate(rpc_server_call_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "gRPC client errors",
      "description": "Calls the lobby and game servers make to each other that failed (heartbeats, takeovers, room moves).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, rpc_response_status_code) (rate(rpc_client_call_duration_seconds_count{rpc_response_status_code!=\"OK\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{rpc_response_status_code}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Auth",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sign-ins and refreshes",
      "description": "refresh reuse_detected means a rotated refresh token was replayed: the RefreshTokenReuse alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(auth_logins_total[$__rate_interval]))",
          "legendFormat": "login {{result}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(auth_refreshes_total[$__rate_interval]))",
          "legendFormat": "refresh {{result}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "API key verifications and JWKS fetches",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(auth_api_keys_verifications_total[$__rate_interval]))",
          "legendFormat": "api key {{result}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, reason, result) (rate(authn_jwks_fetches_total[$__rate_interval]))",
          "legendFormat": "jwks {{service_name}} {{reason}} {{result}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Lobby",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Healthy game servers",
      "description": "Game servers with a heartbeat in the last 6 s. GameServerDown fires below the expected count.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(lobby_servers_healthy)",
          "legendFormat": "healthy"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Room allocations and moves",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(lobby_allocations_total[$__rate_interval]))",
          "legendFormat": "allocation {{result}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(lobby_reassignments_total[$__rate_interval]))",
          "legendFormat": "reassignment {{result}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "Web app (real users, task 5.4)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Largest Contentful Paint p75",
      "description": "From real browsers (web-vitals), by page. Google's bands: good under 2.5 s, poor over 4 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2500
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.75, sum by (page, le) (rate(web_vitals_lcp_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{page}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Interaction to Next Paint p75",
      "description": "Good under 200 ms, poor over 500 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.75, sum by (page, le) (rate(web_vitals_inp_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{page}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Cumulative Layout Shift p75",
      "description": "Unitless. Good under 0.1, poor over 0.25.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.75, sum by (page, le) (rate(web_vitals_cls_bucket[$__rate_interval])))",
          "legendFormat": "{{page}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "WebSocket round trip (browsers)",
      "description": "The room's ping round trip as players' browsers see it (k6's ws_rtt is the load test's).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(web_ws_rtt_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(web_ws_rtt_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 53,
        "w": 12,
        "h": 8
      }
    }
  ]
}
