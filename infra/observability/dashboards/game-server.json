    {
      "id": 16,
      "type": "timeseries",
      "title": "Viewer broadcast latency",
      "description": "From the owner's commit (the stream entry's time) until the write to a viewer's socket returns, p50 and p99 over every viewer; and the share of that spent before the relay read the event (stream lag, p99). SlowRelayBroadcast watches p99, target under 250 ms (M6).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_broadcast_latency_milliseconds_bucket[1m])))",
          "legendFormat": "broadcast p99"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
