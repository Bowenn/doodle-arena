    {
      "id": 13,
      "type": "timeseries",
      "title": "Input and send lag",
      "description": "Input lag: a player's message waiting for its room's actor (behind earlier steps' Redis commits). Send lag: a message waiting to be written to a socket, plus the write. SlowBroadcasts fires when either p95 stays above 250 ms. Read them with Scheduler latency: high there too means the CPU is pinned; send lag alone means slow clients.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(game_room_input_lag_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "input p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service_instance_id, le) (rate(game_room_input_lag_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "input p95 {{service_instance_id}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(game_ws_send_lag_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "send p50"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service_instance_id, le) (rate(game_ws_send_lag_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "send p95 {{service_instance_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Scheduler latency",
      "description": "How long the game server's runnable goroutines waited for a CPU (Go runtime). Above a few milliseconds the server can't keep up, and send lag follows.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
