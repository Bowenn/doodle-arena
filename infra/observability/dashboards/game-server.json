          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(go_schedule_duration_seconds_bucket{service_name=\"game-server\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (service_instance_id, le) (rate(go_schedule_duration_seconds_bucket{service_name=\"game-server\"}[$__rate_interval])))",
          "legendFormat": "p99 {{service_instance_id}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      }
