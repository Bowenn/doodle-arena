    {
      "id": 15,
      "type": "timeseries",
      "title": "ACL denials by principal",
      "description": "Requests the broker refused, from its log (each denial names the principal, operation and resource). The authorizer's own denied-rate metric (panel above) also counts unauthorized topics it quietly leaves out of metadata answers, so it never reads zero; these are the real refusals.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (principal) (count_over_time({service_name=\"kafka\"} |= \"is Denied\" | regexp \"Principal = User:(?P<principal>[^ ]+) is Denied\" [$__auto]))",
          "legendFormat": "{{principal}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      }
    },
