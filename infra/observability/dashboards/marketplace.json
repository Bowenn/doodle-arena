          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (target, reason) (rate(market_db_reads_total[5m]))",
          "legendFormat": "marketplace {{target}}: {{reason}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (target, reason) (rate(assets_db_reads_total[5m]))",
          "legendFormat": "assets {{target}}: {{reason}}"
        }
