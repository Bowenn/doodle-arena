{
  "uid": "da-analytics",
  "title": "Doodle Arena: analytics",
  "description": "The Flink job (ADR 0018): health, checkpoints, Kafka, top guesses and wash-trading flags.",
  "tags": [
    "doodle-arena"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "doodle-arena"
      ],
      "asDropdown": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "rgba(255, 152, 48, 1)",
        "name": "Deploys",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "The job (ADR 0018: one Flink job, checkpoints every 30 s)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Job running for",
      "description": "Since the job last started (Flink's uptime). Missing or 0: the job isn't running; AnalyticsDown fires once it ran in the last 6 hours and hasn't for 2 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "missing",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(flink_jobmanager_job_uptime) / 1000",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Since the last checkpoint",
      "description": "Seconds since a checkpoint last completed. Checkpoints come every 30 s; over 300 s on a job up for 5 minutes fires AnalyticsDown (a restart would lose more than that).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "missing",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(flink_jobmanager_job_lastCheckpointCompletedTimestamp) / 1000",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Restarts",
      "description": "Restarts of the job inside this JobManager (task or TaskManager failures; Flink restores the last checkpoint each time). A new JobManager starts again from 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(flink_jobmanager_job_numRestarts)",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed checkpoints",
      "description": "Checkpoints that failed since the job started. A few is weather (a slow S3 call); a growing count means state isn't being saved.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(flink_jobmanager_job_numberOfFailedCheckpoints)",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Checkpoint duration",
      "description": "How long the last checkpoint took, from trigger to completion, and its size: wash trading's 7 days of sales grow it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(flink_jobmanager_job_lastCheckpointDuration)",
          "legendFormat": "duration (ms)"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Checkpoint size",
      "description": "The last checkpoint's full size.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(flink_jobmanager_job_lastCheckpointFullSize)",
          "legendFormat": "full size"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Kafka in",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Records read per source",
      "description": "Records each Kafka source emits per second (guesses and sales).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (operator_name) (flink_taskmanager_job_task_operator_numRecordsOutPerSecond_rate{operator_name=~\"Source: .*\"})",
          "legendFormat": "{{operator_name}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Consumer lag (group analytics)",
      "description": "Messages not yet read, from the broker (kafka-metrics). Flink commits offsets at each checkpoint, so it rises and falls every 30 s by design; a steady climb means the job is behind or stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (kafka_consumer_group_lag_sum{group=\"analytics\"})",
          "legendFormat": "{{topic}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Watermark lag",
      "description": "How far each source's watermark trails the wall clock. It grows on quiet topics (no new event time) and is only a problem while records arrive: windows then close late.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (operator_name) (flink_taskmanager_job_task_operator_watermarkLag{operator_name=~\"Source: .*\"})",
          "legendFormat": "{{operator_name}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Records skipped",
      "description": "Records the job couldn't use (unreadable, unknown event, missing fields): logged with topic, partition and offset, then skipped (ADR 0004).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(flink_taskmanager_job_task_operator_deserializer_analytics_guesses_skipped_total[5m]))",
          "legendFormat": "guesses"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(flink_taskmanager_job_task_operator_deserializer_analytics_sales_skipped_total[5m]))",
          "legendFormat": "sales"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Top guesses (live.guesses.v1 to live.top-guesses.v1)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Guesses and lists",
      "description": "Viewer guesses read, guesses dropped as late (behind the watermark: their window was already reported), and TopGuesses written.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(flink_taskmanager_job_task_operator_deserializer_analytics_guesses_read_total[5m]))",
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(flink_taskmanager_job_task_operator_analytics_guesses_late_total[5m]))",
          "legendFormat": "late"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(flink_taskmanager_job_task_operator_analytics_top_guesses_emitted_total[5m]))",
          "legendFormat": "TopGuesses written"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Wash trading (market.sales.v1 to analytics.flags.v1)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Loops flagged",
      "description": "WashTradeFlagged by rule over 15 minutes: round_trip (R1, A to B to A) and cycle (R3, three or more accounts). Any fires WashTradingFlagged. A series that is new in the window (a restarted job) counts with its whole value: increase() misses a counter that starts above 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rule) ((increase(flink_taskmanager_job_task_operator_rule_analytics_wash_trades_flagged_total[15m]) and flink_taskmanager_job_task_operator_rule_analytics_wash_trades_flagged_total offset 15m) or (flink_taskmanager_job_task_operator_rule_analytics_wash_trades_flagged_total unless flink_taskmanager_job_task_operator_rule_analytics_wash_trades_flagged_total offset 15m))",
          "legendFormat": "{{rule}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Sales read",
      "description": "Completed sales the detector read per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(flink_taskmanager_job_task_operator_deserializer_analytics_sales_read_total[5m]))",
          "legendFormat": "sales"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Flags (analytics logs)",
      "description": "Each flag's rule, drawing, accounts, sales, volume and flag_id (search analytics.flags.v1 with eventctl for the event).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"analytics\"} |= \"wash trade flagged\""
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      }
    }
  ]
}
