# Doodle Arena gateway: reverse proxy for every service (design doc, section 4.1).
# The gateway only routes. Each service verifies JWTs itself (ADR 0001).
#
# A template: at start, the image's entrypoint renders it to /etc/nginx/nginx.conf with the
# SERVICE_* variables from the environment (only SERVICE_* names are substituted, so nginx's
# own $variables stay as they are). The Dockerfile's defaults are the local stack's; in AWS
# (ADR 0003) the task sets the collector, the environment, the DNS resolver, the services'
# domain and the load balancer's addresses.

# OpenTelemetry tracing (ships in the official image's -otel variant).
load_module modules/ngx_otel_module.so;
# njs, for the identity-header check (identity.js; ships in the official image).
load_module modules/ngx_http_js_module.so;

worker_processes auto;
error_log /dev/stderr notice;

events {
    worker_connections 4096;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    # Every proxied request gets a server span, exported over OTLP/gRPC (the only protocol
    # this module speaks) to the collector. The span continues an incoming traceparent or
    # starts a trace, and the traceparent sent upstream makes services' spans its children.
    otel_exporter {
        endpoint ${SERVICE_OTLP_ENDPOINT};
    }
    otel_service_name gateway;
    otel_resource_attr service.version ${SERVICE_VERSION};
    otel_resource_attr service.instance.id ${SERVICE_INSTANCE_ID};
    otel_resource_attr deployment.environment ${SERVICE_ENVIRONMENT};
    otel_trace on;
    otel_trace_context propagate;

    # One JSON object per request. The path is logged without its query string, because
    # query strings can carry OAuth codes and other secrets. trace_id and span_id link the
    # line to its trace (gateway logs stay in stdout; only the traces are exported).
    log_format json escape=json
        '{"timestamp":"$time_iso8601","level":"info","service":"gateway","version":"${SERVICE_VERSION}",'
        '"trace_id":"$otel_trace_id","span_id":"$otel_span_id",'
        '"msg":"request","request_id":"$request_id","method":"$request_method","path":"$uri",'
        '"status":$status,"duration_s":$request_time,"upstream":"$upstream_addr"}';
    access_log /dev/stdout json;

    # Docker's embedded DNS locally, the VPC's resolver in AWS. Resolving at request time lets
    # the gateway start, and keep running, while a service is down or restarting, and follows a
    # service whose tasks were replaced (new addresses).
    resolver ${SERVICE_RESOLVER} valid=10s ipv6=off;

    # Behind a load balancer (AWS), the client's address is the last one the load balancer adds
    # to X-Forwarded-For; only the load balancer's own addresses are trusted to set it, so a
    # client can't pick its address for the rate limits below. Locally nothing is trusted.
    set_real_ip_from ${SERVICE_TRUSTED_PROXIES};
    real_ip_header X-Forwarded-For;

    # Defaults for every proxied location; long-lived WebSockets override the read timeout.
    proxy_connect_timeout 2s;
    proxy_read_timeout 30s;

    # Coarse per-IP rate limits (leaky bucket). Fine-grained limits, such as the per-player
    # guess token bucket, live in the services (design doc D12). $binary_remote_addr is the
    # client's address, also behind the load balancer (real_ip above).
    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;
    # Browser telemetry: a page posts its Web Vitals once, on page hide (task 5.4).
    limit_req_zone $binary_remote_addr zone=telemetry:10m rate=2r/s;
    limit_req_status 429;
    limit_req_log_level warn;

    # '1' when a client sent an X-User-* or X-Roles header (identity.js).
    js_import identity from /etc/nginx/identity.js;
    js_set $identity_header identity.hasIdentityHeader;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Game WebSockets (ADR 0002): /ws/<server_id>/rooms/<room_id> goes to that game server.
    # An explicit map, never the path segment as a host name: that would let a client reach
    # any internal service (postgres, redis, ...).
    map $ws_server $ws_upstream {
        default        "";
        game-server-1  game-server-1${SERVICE_DOMAIN}:8080;
        game-server-2  game-server-2${SERVICE_DOMAIN}:8080;
    }

    # /healthz/<service> targets. Restricted to internal traffic in AWS (ADR 0003).
    map $health_service $health_url {
        default        "";
        auth           http://auth${SERVICE_DOMAIN}:8080/healthz;
        lobby          http://lobby${SERVICE_DOMAIN}:8080/healthz;
        game-server-1  http://game-server-1${SERVICE_DOMAIN}:8080/healthz;
        game-server-2  http://game-server-2${SERVICE_DOMAIN}:8080/healthz;
        assets         http://assets${SERVICE_DOMAIN}:8080/healthz;
        ai             http://ai${SERVICE_DOMAIN}:8080/healthz;
        marketplace    http://marketplace${SERVICE_DOMAIN}:8080/healthz;
        notifier       http://notifier${SERVICE_DOMAIN}:8080/healthz;
        web            http://web${SERVICE_DOMAIN}:${SERVICE_WEB_PORT}/;
    }

    server {
        listen 80;
        client_max_body_size 1m;

        # Identity comes only from the JWT (ADR 0001): refuse X-User-* and X-Roles headers on
        # every route rather than pass them on.
        if ($identity_header) {
            rewrite ^ /_identity_refused last;
        }
        location = /_identity_refused {
            internal;
            default_type application/json;
            return 400 '{"error":{"code":"IDENTITY_HEADER","message":"X-User-* and X-Roles headers are not accepted","request_id":"$request_id"}}\n';
        }

        error_page 429 = @rate_limited;
        location @rate_limited {
            default_type application/json;
            add_header Retry-After 1 always;
            return 429 '{"error":{"code":"RATE_LIMITED","message":"too many requests","request_id":"$request_id"}}\n';
        }

        location = /healthz {
            access_log off;
            otel_trace off;
            default_type application/json;
            return 200 '{"status":"ok","service":"gateway"}\n';
        }

        location ~ ^/healthz/(?<health_service>[a-z0-9-]+)$ {
            access_log off;
            otel_trace off;
            if ($health_url = "") {
                return 404;
            }
            include /etc/nginx/proxy_common.conf;
            proxy_pass $health_url;
        }

        # Public API routes keep their full path; each service owns its prefix.
        location /api/auth/ {
            limit_req zone=api burst=40 nodelay;
            include /etc/nginx/proxy_common.conf;
            set $upstream auth${SERVICE_DOMAIN}:8080;
            proxy_pass http://$upstream;
        }

        # Google's redirect back carries the authorization code and state in its query, and the
        # module's span would record them (http.target): this one route isn't traced. The auth
        # service's span, with the query redacted, still records the callback, as a trace of its
        # own: with tracing off, the module would still send a traceparent, unsampled, and auth
        # would drop its span too, so no trace context is sent either.
        location = /api/auth/google/callback {
            otel_trace off;
            otel_trace_context ignore;
            limit_req zone=auth burst=10 nodelay;
            limit_req zone=api burst=40 nodelay;
            include /etc/nginx/proxy_common.conf;
            set $upstream auth${SERVICE_DOMAIN}:8080;
            proxy_pass http://$upstream;
        }

        # Sign-in and token refresh get a stricter limit: they are what an attacker would hammer.
        location ~ ^/api/auth/(google/|refresh$) {
            limit_req zone=auth burst=10 nodelay;
            limit_req zone=api burst=40 nodelay;
            include /etc/nginx/proxy_common.conf;
            set $upstream auth${SERVICE_DOMAIN}:8080;
            proxy_pass http://$upstream;
        }

        location /api/lobby/ {
            limit_req zone=api burst=40 nodelay;
            include /etc/nginx/proxy_common.conf;
            set $upstream lobby${SERVICE_DOMAIN}:8080;
            proxy_pass http://$upstream;
        }

        location /api/assets/ {
            limit_req zone=api burst=40 nodelay;
            include /etc/nginx/proxy_common.conf;
            set $upstream assets${SERVICE_DOMAIN}:8080;
            proxy_pass http://$upstream;
        }

        location /admin/ {
            limit_req zone=api burst=40 nodelay;
            include /etc/nginx/proxy_common.conf;
            set $upstream assets${SERVICE_DOMAIN}:8080;
            proxy_pass http://$upstream;
        }

        location /api/market/ {
            limit_req zone=api burst=40 nodelay;
            include /etc/nginx/proxy_common.conf;
            set $upstream marketplace${SERVICE_DOMAIN}:8080;
            proxy_pass http://$upstream;
        }

        location /api/notifier/ {
            limit_req zone=api burst=40 nodelay;
            include /etc/nginx/proxy_common.conf;
            set $upstream notifier${SERVICE_DOMAIN}:8080;
            proxy_pass http://$upstream;
        }

        # Browser telemetry (task 5.4): the web app's Web Vitals, to the collector's browser
        # receiver, which keeps only the web app's own metrics (infra/observability/otelcol/
        # browser.yaml). POST only, small bodies, a per-address limit; not traced (a span per
        # beacon would only describe the beacon).
        location = /otlp/v1/metrics {
            otel_trace off;
            otel_trace_context ignore;
            access_log off;
            limit_except POST {
                deny all;
            }
            client_max_body_size 64k;
            limit_req zone=telemetry burst=10 nodelay;
            include /etc/nginx/proxy_common.conf;
            set $upstream ${SERVICE_OTLP_BROWSER};
            proxy_pass http://$upstream/v1/metrics;
        }

        # Game WebSockets. Not traced here: a span would last as long as the game. The game
        # server traces the handshake (game.ws.connect) itself.
        location ~ ^/ws/(?<ws_server>[a-z0-9-]+)/rooms/[a-z0-9]+$ {
            otel_trace off;
            limit_req zone=api burst=40 nodelay;
            if ($ws_upstream = "") {
                return 404;
            }
            include /etc/nginx/proxy_common.conf;
            include /etc/nginx/websocket.conf;
            proxy_pass http://$ws_upstream;
        }

        location /ws/ {
            return 404;
        }

        # Everything else is the web app: the Vite dev server locally, including its hot-reload
        # WebSocket; the static production build in AWS.
        location / {
            # Dev-server assets aren't traced (dozens per page load); browser telemetry comes
            # with task 5.4.
            otel_trace off;
            include /etc/nginx/proxy_common.conf;
            include /etc/nginx/websocket.conf;
            set $upstream web${SERVICE_DOMAIN}:${SERVICE_WEB_PORT};
            proxy_pass http://$upstream;
        }
    }
}
