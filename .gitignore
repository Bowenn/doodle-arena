# Secrets and local config
.env
.env.backup
secrets/
*.pem
*.key
docs/_review

# OS and editors
.DS_Store
.idea/
.vscode/
*.swp

# Local tool state
.remember/

# Go
services/*/bin/
proto/gen/java/bin/
tools/eventctl/eventctl
coverage.out

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Java / Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Node
node_modules/
dist/
web/.lighthouseci/
*.tsbuildinfo

# Terraform (infra/terraform/): providers and local state stay local; the lock file is committed.
.terraform/
.terraform-lint/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
crash.log

# A module has no lock file of its own; the roots pin its providers.
infra/terraform/modules/**/.terraform.lock.hcl
