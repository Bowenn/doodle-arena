# Local development only. Never commit .env.
# scripts/dev-up.sh copies this file to .env and replaces every "change-me" with a random value.

# Postgres: superuser plus one user per service database
POSTGRES_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
ASSETS_DB_PASSWORD=change-me
MARKETPLACE_DB_PASSWORD=change-me
NOTIFIER_DB_PASSWORD=change-me

# MongoDB root user (the assets service gets its own user in Stage 3)
MONGO_ROOT_PASSWORD=change-me

# SeaweedFS S3 credentials (S3 in AWS uses IAM roles instead)
S3_ACCESS_KEY=doodle-local
S3_SECRET_KEY=change-me

# Django (assets)
DJANGO_SECRET_KEY=change-me

# Google OAuth client (see docs/setup.md). Without it, the stack runs but sign-in returns 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the short-lived cookie that carries OAuth state, nonce and PKCE verifier (auth)
OAUTH_STATE_SECRET=change-me

# Signing keys are not configured here: scripts/gen-jwt-key.sh creates secrets/jwt-private.pem (auth)
# and scripts/gen-ticket-key.sh creates secrets/ticket-private.pem (lobby, join tickets). Compose
# mounts each key as a secret into the one service that signs with it.
