# Local development only. Never commit .env.
# scripts/dev-up.sh copies this file to .env and replaces every "change-me" with a random value.

# Postgres: superuser plus one user per service database
POSTGRES_PASSWORD=change-me
# The read replica's streaming user (ADR 0020).
POSTGRES_REPLICATION_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
ASSETS_DB_PASSWORD=change-me
MARKETPLACE_DB_PASSWORD=change-me
NOTIFIER_DB_PASSWORD=change-me

# MongoDB: the root user, and the assets service's own user (infra/mongo/create-users.js)
MONGO_ROOT_PASSWORD=change-me
MONGO_ASSETS_PASSWORD=change-me

# Kafka (ADR 0013, infra/kafka/broker.sh and init.sh): three super users, admin for humans only,
# kafka-init for the init job and broker for the broker itself; then one SCRAM user per
# service. dev-tools is for the host tools: eventctl, fake-events.sh, the drills, pipeline-check.
KAFKA_ADMIN_PASSWORD=change-me
KAFKA_INIT_PASSWORD=change-me
KAFKA_BROKER_PASSWORD=change-me
KAFKA_GAME_SERVER_PASSWORD=change-me
KAFKA_LOBBY_PASSWORD=change-me
KAFKA_ASSETS_PASSWORD=change-me
KAFKA_MARKETPLACE_PASSWORD=change-me
KAFKA_NOTIFIER_PASSWORD=change-me
KAFKA_AUTH_PASSWORD=change-me
KAFKA_METRICS_PASSWORD=change-me
KAFKA_ANALYTICS_PASSWORD=change-me
KAFKA_RELAY_PASSWORD=change-me
KAFKA_DEV_TOOLS_PASSWORD=change-me

# Redis: one ACL user per service and key prefix (infra/redis/start.sh), and admin for the
# healthcheck and humans (redis-cli --user admin with REDISCLI_AUTH)
REDIS_ADMIN_PASSWORD=change-me
REDIS_LOBBY_PASSWORD=change-me
REDIS_GAME_SERVER_PASSWORD=change-me
REDIS_ASSETS_PASSWORD=change-me
REDIS_RELAY_PASSWORD=change-me
REDIS_MARKETPLACE_PASSWORD=change-me
# Search (ADR 0023): elastic is Elasticsearch's superuser (the init job and humans); assets
# reads (the web process), assets-indexer writes (the indexer).
ELASTIC_PASSWORD=change-me
ELASTICSEARCH_ASSETS_PASSWORD=change-me
ELASTICSEARCH_INDEXER_PASSWORD=change-me

# SeaweedFS S3 identities, one per service and its buckets (infra/seaweedfs/entrypoint.sh;
# S3 in AWS uses IAM task roles instead). S3_ACCESS_KEY and S3_SECRET_KEY are dev-tools', for
# the host tools (scripts/fake-events.sh, pipeline-check): read everything, write round-logs.
S3_ACCESS_KEY=doodle-local
S3_SECRET_KEY=change-me
S3_GAME_SERVER_SECRET_KEY=change-me
S3_ASSETS_SECRET_KEY=change-me
S3_ANALYTICS_SECRET_KEY=change-me

# Django (assets)
DJANGO_SECRET_KEY=change-me

# Google OAuth client (see docs/setup.md). Without it, the stack runs but sign-in returns 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the short-lived cookie that carries OAuth state, nonce and PKCE verifier (auth)
OAUTH_STATE_SECRET=change-me

# Encrypts webhook endpoints' signing secrets at rest (notifier, ADR 0014): random, 32+ characters.
NOTIFIER_SECRET_KEY=change-me

# Stripe in test mode, test keys only (see docs/setup.md). Without them, coin packs return 503.
# STRIPE_WEBHOOK_SECRET is the whsec_ value that `stripe listen` prints.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signing keys are not configured here: scripts/gen-jwt-key.sh creates secrets/jwt-private.pem (auth)
# and scripts/gen-ticket-key.sh creates secrets/ticket-private.pem (lobby, join tickets). Compose
# mounts each key as a secret into the one service that signs with it.

# Discord channel webhook for alerts (docs/setup.md, "Discord"). A secret: anyone holding it can
# post to the channel. Leave it empty to send alerts to the webhook-receiver test service instead.
DISCORD_ALERT_WEBHOOK_URL=
